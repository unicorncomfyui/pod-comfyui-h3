# pod-comfyui-h3 - environment variables
# Copy to .env for local runs. On RunPod, set these in the template instead.

# --- Services ---------------------------------------------------------------
VSCODE_PORT=8080
COMFYUI_PORT=3000

# --- Models -----------------------------------------------------------------
# Fetch weights on first boot. Needs a network volume (up to 63 GB).
DOWNLOAD_MODELS=true

# Which sets from models/manifest.json to download. Comma-separated, or one of
# the keywords: default / all / none.
#   minimax-h3-fl2va      T2V + I2V          42.5 GB
#   minimax-h3-ref2va     Reference-to-Video +21 GB (shares encoder and VAEs)
#   minimax-h3-turbo-lora 4-step LoRA        +0.8 GB (needs the Turbo Sampler)
#   minimax-h3-fp8        fp8_scaled variant of fl2va
#   minimax-h3-hq         unpruned int8, multi-GPU / heavy-RAM hosts only
MODEL_SETS=minimax-h3-fl2va,minimax-h3-ref2va,minimax-h3-turbo-lora

# Only needed for gated repos. Comfy-Org/MiniMax-H3 is public.
HF_TOKEN=

# Where mutable data lives on the volume.
COMFYUI_DATA_DIR=/workspace/comfyui-data

# --- Memory tuning ----------------------------------------------------------
# Dynamic VRAM (comfy-aimdo) is on by default and is what makes H3 fit on a
# 32 GB card. Do NOT add --lowvram: it disables that path.

# Trade host RAM for disk when offloading. OFF by default: it only pays off on
# fast *local* NVMe, whereas the target pod has 92 GB of RAM (a workflow's
# weights fit outright) and keeps the weights on a network volume. Turn it on
# only if you end up on a RAM-starved pod.
FAST_DISK=false

# Extra VRAM (GB) DynamicVRAM keeps free. Raise it if you hit OOM mid-sampling.
VRAM_HEADROOM=

# VRAM (GB) reserved for the OS and other processes.
RESERVE_VRAM=

# --- Performance levers -----------------------------------------------------
# All opt-in, all A/B testable without rebuilding. Change ONE at a time and
# compare against a fixed prompt and seed, or you will not know what moved.

# Keep N node results. Biggest structural win when iterating: without it the
# 15 GB text encoder is re-staged on every prompt even when the text has not
# changed. Start at 10. Costs RAM, which this pod has in abundance.
CACHE_LRU=

# ComfyUI's --fast. Space-separated subset of:
#   fp16_accumulation  fp8_matrix_mult  cublas_ops  autotune
# or "all". Upstream labels these "untested and potentially quality
# deteriorating" - judge the output, not only the clock.
FAST_MODE=

# Weight-offload streams, default 2. A run stages ~40 GB across PCIe, so this
# is worth probing. Try 4.
ASYNC_OFFLOAD_STREAMS=

# Escape hatch, appended verbatim to the ComfyUI command line.
# Useful under host-RAM pressure: --disable-pinned-memory --cache-none
COMFYUI_EXTRA_ARGS=

# Read one model set into the page cache at boot. Worth it on a network volume,
# where reads are network-bound: it turns unpredictable stalls during the first
# generation into a visible, one-off cost at startup.
# Name a SINGLE set - prewarming more than fits in RAM just evicts itself.
# Skipped automatically if available RAM is insufficient.
PREWARM_SET=minimax-h3-fl2va

# --- Browser access ---------------------------------------------------------
# ComfyUI 403s on any request carrying "Sec-Fetch-Site: cross-site", which is
# exactly what clicking the port link from the RunPod dashboard sends. Enabling
# CORS replaces that middleware, at the cost of its anti-CSRF protection.
# Workaround without this: retype the URL in the address bar (direct navigation
# sends "Sec-Fetch-Site: none").
ENABLE_CORS=true

# Narrow the allowance to your own pod instead of "*", e.g.
# https://<pod-id>-3000.proxy.runpod.net
CORS_ALLOW_ORIGIN=

# --- Local prompt generation (experimental) ---------------------------------
# Nothing here starts on boot. The H3 Prompt Writer extension ships in the
# image and costs nothing until used; the model behind it is 18 GB and its
# runtime another 1.4, so both land on the volume on demand:
#   bash /app/scripts/promptgen.sh start
#
# The tag Ollama pulls. qwen3.8:27b is a dense 27B vision-language model at
# about 18 GB, so it reads your reference images rather than only your brief.
# 27b-nvfp4 is 16.9 GB in the format this card runs natively - newer, and the
# first thing to try if 18 GB is tight.
PROMPTGEN_MODEL=

# How long the prompt model stays on the card after its last request. It CANNOT
# share the card with H3 - 21 GB of diffusion plus 15.7 of text encoder leaves
# nothing. Keeping 5m makes writing several prompts pleasant; set 0 if you
# alternate constantly and would rather pay the reload than remember to unload.
OLLAMA_KEEP_ALIVE=

# Where the runtime and the weights live. Defaults under the data directory, so
# they survive a pod the same way the H3 weights do.
PROMPTGEN_PREFIX=

# --- Optional ---------------------------------------------------------------
# SSH is rarely needed: code-server on 8080 already gives you a terminal, as
# does RunPod's own web terminal. If you enable it, set one of PUBLIC_KEY or
# SSH_PASSWORD - with neither, sshd listens but no login can succeed.
ENABLE_SSH=false
PUBLIC_KEY=
SSH_PASSWORD=
PREVIEW_METHOD=auto
