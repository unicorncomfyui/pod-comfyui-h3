# Force LF line endings for shell scripts
*.sh text eol=lf

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Windows-specific files use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pth binary
*.safetensors binary
